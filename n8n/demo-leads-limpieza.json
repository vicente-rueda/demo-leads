    {
      "id": "a8fba83e-1e23-088a-279f-813989f811fd",
      "name": "Elegir leads de más de 30 días",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const DIAS = 30;\nconst limite = Date.now() - DIAS * 24 * 3600 * 1000;\nconst aMs = (txt) => {\n  const m = String(txt ?? '').match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4}),?\\s+(\\d{2}):(\\d{2}):(\\d{2})$/);\n  if (!m) return null;\n  return Date.UTC(+m[3], +m[2] - 1, +m[1], +m[4], +m[5], +m[6]);\n};\nconst salida = [];\nfor (const fila of $input.all()) {\n  const t = aMs(fila.json.Fecha);\n  if (t === null || t > limite) continue;\n  if (fila.json.Email === '(borrado)') continue;\n  salida.push({ json: { ID: fila.json.ID, Nombre: '(borrado)', Apellido: '(borrado)', Email: '(borrado)', Mensaje: '(borrado)' } });\n}\nreturn salida;"
      },
      "notes": "Deja pasar solo las filas con más de 30 días que aún no estén anonimizadas. Si no hay ninguna, no sale nada y el resto del flujo no se ejecuta. Fecha ilegible = se salta la fila (nunca borra a ciegas)."
    },
