    {
      "id": "155b1e0a-d801-a9a7-6e96-b1d7da716a99",
      "name": "Validar y limpiar datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const entrada = $input.first().json;\nconst body = entrada.body ?? entrada;\nconst limpio = (v, max) => String(v ?? '').replace(/[\\u0000-\\u001f\\u007f]+/g, ' ').trim().slice(0, max);\nconst escapar = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n\nconst nombre = limpio(body.nombre, 60);\nconst apellido = limpio(body.apellido, 60);\nconst email = limpio(body.email, 254).toLowerCase();\nconst mensaje = limpio(body.mensaje, 500);\nconst origen = limpio(body.origen || 'web-form', 30);\n\nconst errores = [];\nif (!nombre) errores.push('El nombre es obligatorio.');\nif (!/^[^\\s@<>,;\"']+@[^\\s@<>,;\"']+\\.[^\\s@<>,;\"']{2,}$/.test(email)) errores.push('El email no es válido.');\nif (limpio(body.web, 100)) errores.push('Solicitud rechazada.');\n\nconst mensajeCorto = mensaje.length > 80 ? mensaje.slice(0, 80) + '...' : mensaje;\nconst fecha = new Date().toLocaleString('es-ES', { timeZone: 'Europe/Madrid', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit' });\nconst id = 'LEAD-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6);\n\nreturn [{ json: {\n  valido: errores.length === 0, errores, id, fecha, origen,\n  nombre, apellido, email, mensaje,\n  nombreH: escapar(nombre), apellidoH: escapar(apellido), emailH: escapar(email), mensajeCortoH: escapar(mensajeCorto),\n} }];"
      },
      "notes": "Recorta longitudes, quita caracteres de control, valida el email (sin comas ni espacios: evita enviar a varias direcciones) y prepara copias con el HTML escapado para el email y Telegram."
    },
